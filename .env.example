# scrabbleBawt live client configuration. Copy to .env (git-ignored, chmod 600) and fill in.
# NEVER commit a real token: there is no revoke reducer for bot credentials.

# Bot token from the team page ("Generate token"). Optional after the first run: the client then
# persists its token to .token-<BOT_NAME> (git-ignored, mode 600) unless BOT_TOKEN is set here.
BOT_TOKEN=<paste-token-here>
BOT_NAME=mybot

# Server. Default is maincloud; local E2E uses http://127.0.0.1:3000 (ws:// and wss:// also accepted).
STDB_HOST=https://maincloud.spacetimedb.com
STDB_DB=scrabblebot

# Strategy: registry name (default 'bawt' when registered, else 'starter') and JSON params.
BOT_POLICY=starter
BOT_PARAMS={}

# Tournament: a tournament id, or 'auto' to register once for any tournament in Registration.
# TOURNAMENT_ID=auto

# Lifecycle: NO_LADDER=1 never joins the lobby; MAX_MATCHES stops after N matches.
NO_LADDER=0
# MAX_MATCHES=3

# Read-only spectating (anonymous identity, no reducers).
SHADOW=0

# Logs (JSONL, tokens redacted).
LOG_DIR=runs/live
LOG_LEVEL=info

# DANGER — Phase 5 only. Game reducers (join_lobby, submit_bid, submit_word, ...) against maincloud
# are blocked unless the REAL shell environment sets ALLOW_MAINCLOUD_PLAY=1. A value in this file
# is ignored on purpose. Leave it commented out.
# ALLOW_MAINCLOUD_PLAY=1
