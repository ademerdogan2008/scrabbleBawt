{
  "name": "scrabblebawt",
  "version": "0.1.0",
  "description": "Championship bot for ScrabbleBot, the SpacetimeDB letter-auction word game",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "tsx src/sim/cli.ts",
    "start": "tsx src/client/main.ts",
    "learn": "tsx scripts/learn-cycle.ts --watch --live-only",
    "evolve": "tsx scripts/evolve.ts",
    "demo:local": "bash scripts/demo-local.sh",
    "demo:bench": "tsx scripts/bawt-bench.ts --matches 200 --only lobbySims,starterFlood,h2hStarter,zoo:",
    "demo:shadow": "tsx scripts/client-shadow.ts --matches 1 --policy bawt --full-only --timeout-min 10",
    "monitor": "tsx scripts/live-monitor.ts"
  },
  "dependencies": {
    "spacetimedb": "2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
